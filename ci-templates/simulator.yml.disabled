name: ENH6-simulator-smoke
on:
  push:
    branches: [experiment/simulator-2026-10-08]
    paths: [.github/workflows/simulator.yml]
permissions:
  contents: read
jobs:
  smoke:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    env:
      VB_EMULATOR: '1'
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Free disk and enable KVM
        run: |
          sudo rm -rf /usr/local/lib/android/sdk/ndk /usr/share/dotnet /usr/local/share/boost /opt/ghc
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - name: Models and x86 emulator test build
        run: |
          bash scripts/fetch_models.sh
          ./gradlew --no-daemon assembleDebug assembleDebugAndroidTest -Dorg.gradle.jvmargs="-Xmx4g"
          python -m pip install grpcio grpcio-tools
          python -m grpc_tools.protoc -I scripts/emulator-smoke --python_out=scripts/emulator-smoke --grpc_python_out=scripts/emulator-smoke scripts/emulator-smoke/emulator_audio.proto
      - uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 34
          arch: x86_64
          target: google_apis
          disable-animations: true
          emulator-options: -no-window -gpu swiftshader_indirect -no-snapshot -no-boot-anim -camera-back virtualscene -camera-front emulated -grpc 8554
          script: |
            adb install app/build/outputs/apk/debug/app-debug.apk
            adb install app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk
            bash scripts/emulator-smoke/run.sh
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: ENH6-emulator-smoke-evidence
          path: smoke-result/
          retention-days: 1
